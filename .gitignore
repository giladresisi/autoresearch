# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
worktrees/
results/
queue/

# Agent prompt files (generated per-session by launchers)
AGENTS.md

# Experimental code/artifacts
dev/

# Results and trade log files
results.tsv
trades.tsv

# Harness upgrade reflections (per-worktree, untracked like results.tsv)
harness_upgrade.md

# Test logs
*.log

# Cached parquet slices for regression tests (generated locally from full parquets)
tests/fixtures/*.parquet

# Environment variables
.env

# Live session logs (real trading data, not committed)
# LEGACY: live sessions now live in <global>/sessions/ (outside any worktree); kept harmless.
sessions/

# Parquet data files + their backups/temps (large, machine-local — NEVER committed).
# Production parquets live in <global>/general/{main,live}/ and its per-contract rollover
# subfolders (e.g. main/2026-09/) — all OUTSIDE this worktree, so git never sees them. The
# global patterns below cover any stray parquet/backup/temp anywhere in the tree (incl. the
# legacy worktree-local data/ leftovers). No parquet is tracked.
*.parquet
*.parquet.bak
*.parquet.tmp
*.parquet.promote.tmp
data/*.parquet
data/historical/*.parquet
data/realtime/*.parquet

# Agent format-patch archives (stored in .agents/ but not committed)
.agents/*.patch
trades.tsv

# SMT v2 regression outputs (baselines are local, not committed)
# The regression/ root holds tracked tooling (plot_regression.py); only the machine-local
# per-date run folders under regression/sessions/ are ignored.
regression/sessions/
# LEGACY: pre-restructure regression outputs (now under regression/sessions/); harmless.
data/regression/*/

# SMT v2 runtime state files (ephemeral, not committed)
# LEGACY: state JSONs now resolve under paths.state_dir() (session / per-run folder); harmless.
data/*.json

# Orchestrator runtime files
orchestrator.pid

# Local regression notes
regression.md

# POC/blind-test working folder (slices, per-run facts, agent outputs) - never tracked
agent-docs/strategy/poc/

# Calibration sweep cut folders (regenerable facts + per-run agent outputs) - never tracked
calibration/cuts/

# L1 lifecycle bench run artifacts (plan 10; per-run lifecycles/decisions/scorecards) - never tracked
agent/bench/runs/

# Manual L1 thesis test run artifacts (regenerable per-run JSON + explanation markdown; the
# harness script itself IS tracked) - never commit these
manual-l1-thesis/*.json
manual-l1-thesis/latest_explanation*.md

# Cycle 5 position-policy sweep artifacts (plan 33). Regenerable from
# `scripts/report_position_policy.py` and the study modules, and together they were 97%
# of f4a5c44's 519k inserted lines (12.6 MB). The CONCLUSIONS drawn from them live in
# `.agents/plans/33.cycle5-position-policy.md` §9 and the execution report; these are the
# raw per-session rows behind those tables. Untracked, NOT deleted.
.agents/rule-search/position_policy.json
.agents/rule-search/position_policy_stop_width_sweep.json
