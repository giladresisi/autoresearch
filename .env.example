# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required by the session orchestrator daemon (orchestrator/main.py).
DATABENTO_API_KEY=<your-databento-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── Stage 2: Live Trading via PickMyTrade ─────────────────────────
# Set LIVE_TRADING=true to launch automation/main.py instead of signal_smt.py
LIVE_TRADING=false

# PickMyTrade credentials (required when LIVE_TRADING=true)
PMT_WEBHOOK_URL=<set-pmt-webhook-url>
PMT_API_KEY=<set-pmt-api-key>

# Tradovate / Apex account IDs — comma-separated list; use one entry for a single account
# e.g. TRADING_ACCOUNT_IDS=Apex_123456,Apex_789012
TRADING_ACCOUNT_IDS=<account-id-1>,<account-id-2>

# Tradovate web UI credentials (used by reports/get_tradovate_orders.py)
TRADOVATE_USERNAME=<tradovate-username>
TRADOVATE_PASSWORD=<set-a-secret-here>

# PickMyTrade web UI credentials (used by reports/get_pickmytrade_alerts.py)
PMT_EMAIL=<your-pickmytrade-email>
PMT_PASSWORD=<set-a-secret-here>
TRADING_SYMBOL=MNQ1!
TRADING_CONTRACTS=1

# IB client ID for automation process (must not conflict with signal_smt.py's 15)
AUTOMATION_IB_CLIENT_ID=20

# IB client ID for the realtime-data verification script used by the run-orchestrator
# maintenance-break cycle (.claude/skills/run-orchestrator/scripts/verify_ib_realtime.py).
# Must not conflict with other IB clients (gap-fill 17, automation 20/21, signal_smt 15).
IB_VERIFY_CLIENT_ID=19

# IB contract IDs for the active quarterly MNQ / MES futures.
# Look up via TWS (right-click contract → Financial Instrument Info → Details)
# or run: uv run python -c "from ib_insync import IB,ContFuture; ib=IB(); ib.connect('127.0.0.1',4002,clientId=99); [print(s,ib.qualifyContracts(ContFuture(s,'CME','USD'))) for s in ['MNQ','MES']]; ib.disconnect()"
# Update after each quarterly rollover (Mar/Jun/Sep/Dec expiry).
MNQ_CONID=<mnq-front-month-conid>
MES_CONID=<mes-front-month-conid>

# Next quarterly rollover-prep date (Saturday before the next contract's expiry, YYYY-MM-DD).
# parquet-check runs the rollover-prep once current date >= this, then advances it a quarter.
ROLLOVER_PREP_DATE=<yyyy-mm-dd-saturday-before-next-expiry>

# Sessions directory for fills.jsonl output (default: sessions)
SESSIONS_DIR=sessions
