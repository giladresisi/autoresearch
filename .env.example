# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required by the session orchestrator daemon (orchestrator/main.py).
DATABENTO_API_KEY=<your-databento-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# GIL-44 decision-agent runner (agent/run_agent.py). When OPENROUTER_API_KEY is set the
# runner uses the OpenRouter backend (Anthropic-pinned, no fallbacks); otherwise it falls
# back to the direct Anthropic API via ANTHROPIC_API_KEY above.
OPENROUTER_API_KEY=<your-openrouter-api-key>

# SMT pipeline version: "v1" (default) or "v2"
SMT_PIPELINE=v2

# GIL-44 Phase-3 AI decisions engine (observation-only; master flag default OFF). Set
# ACT_AI_DECISIONS=1 to run the async decision worker in the backtest + live paths (logs
# decisions, never acts on them). ACT_AI_DECISIONS_SHUTDOWN_TIMEOUT bounds the live
# session-end teardown of that worker (numeric seconds, default 8.0) so a wedged in-flight
# LLM call can never delay position/limit cleanup at session close.
ACT_AI_DECISIONS=0
ACT_AI_DECISIONS_SHUTDOWN_TIMEOUT=8.0

# Analyzer/Planner/Executor chain (the agent stack). ON BY DEFAULT, and since plan 38 it
# SELECTS THE BRAIN in the live process (automation/main.py only):
#
#   ACT_TRADER unset / on  -> the AGENT owns the dispatcher. Its entries, stops and exits
#                             go out as real market-entry / market-close orders, and the
#                             legacy engine is DARK. There is no "agent observes while
#                             legacy trades" mode any more.
#   ACT_TRADER=0           -> LEGACY owns the dispatcher, exactly as before. This is the
#                             rollback (set it and restart); the graft is never built.
#
# Whether an order actually reaches the broker is unchanged and decided below:
#   ACT_TRADER on + LIVE_TRADING=true                      LIVE
#   ACT_TRADER on + LIVE_TRADING=true + DISCONNECTED=true  shadow-live (nothing is sent)
#
# The agent REFUSES to start (one "[AGENT-LIVE] REFUSED: <reason>" line, then NO brain
# trades — it never falls back to legacy) when SMT_PIPELINE is not v2, FORCE_RESET=true,
# ACT_AI_MODE=primary, or the trader cannot be built (e.g. no model key). Manual
# trade.py orders and the pause file keep working on such a day.
#
# Live requirements: start BEFORE 09:20 ET (the arm is an exact-minute test) and do not
# restart mid-session (a restart that finds a plan on disk stays dark for the day).
# Leave ACT_TRADER_ARM_HHMM unset in live.
# NOTE: LIVE_TRADING=false launches signal_smt.py, a different program the chain is not
# wired into.
# ACT_TRADER=0
# Optional: which LLM backend/model the Analyzer's 09:20 thesis call uses. Leave BOTH
# unset in live: the backend is then auto-selected by whichever key exists above
# (OPENROUTER_API_KEY preferred, else ANTHROPIC_API_KEY) and the model is that backend's
# default. One of the two keys MUST be present in THIS worktree's .env.
# ACT_TRADER_BACKEND=
# ACT_TRADER_MODEL=

# ── Stage 2: Live Trading via PickMyTrade ─────────────────────────
# Set LIVE_TRADING=true to launch automation/main.py instead of signal_smt.py
LIVE_TRADING=false

# PickMyTrade credentials (required when LIVE_TRADING=true)
PMT_WEBHOOK_URL=<set-pmt-webhook-url>
PMT_API_KEY=<set-pmt-api-key>

# Tradovate / Apex account IDs — comma-separated list; use one entry for a single account
# e.g. TRADING_ACCOUNT_IDS=Apex_123456,Apex_789012
TRADING_ACCOUNT_IDS=<account-id-1>,<account-id-2>

# Tradovate web UI credentials (used by reports/get_tradovate_orders.py)
TRADOVATE_USERNAME=<tradovate-username>
TRADOVATE_PASSWORD=<set-a-secret-here>

# PickMyTrade web UI credentials (used by reports/get_pickmytrade_alerts.py)
PMT_EMAIL=<your-pickmytrade-email>
PMT_PASSWORD=<set-a-secret-here>
TRADING_SYMBOL=MNQ1!
# Order size — and, since plan 38, also the `contracts` that position.json records for a
# new position. The agent's watchdog kills its plan if the two ever disagree.
TRADING_CONTRACTS=1

# Shadow-live mode. When true, the PickMyTrade executor evaluates and logs every order it
# WOULD send (entries, closes, cancels, SL updates) but never POSTs to the PMT webhook — so
# the broker sees nothing while the strategy runs fully in resumed mode. Lets you compare, in
# retrospect, what live would have done vs the regression, with zero broker risk. Read once at
# startup, so it is fixed for the orchestrator's lifetime (toggling .env mid-run has no effect
# until the next restart). Default false = normal live sending.
DISCONNECTED=false

# Broker reconcile, both stages. Default false = NO broker reconcile at any stage of a trade.
# ON_CLOSE: the synchronous pre-close Tradovate read (a headed-browser login on the bar thread)
# that may SUPPRESS or replace the strategy's close. Leave false until its blotter selectors
# have passed a supervised live smoke: an unparsable blotter reads as 'broker flat' and would
# withhold a real close. ON_FILL: the GIL-36 post-fill stop-loss verify and its reader thread.
BROKER_RECONCILE_ON_CLOSE=false
BROKER_RECONCILE_ON_FILL=false

# Daily realized-loss kill switch (live-only; automation.main). Once cumulative assumed
# realized session P&L (script-calculated, no broker reconciliation) drops to or below
# LOSS_LIMIT_DOLLARS, new automatic entries are paused (exits stay active). The pause
# auto-clears at the next session start. Set LOSS_LIMIT_ENABLED=false to disable.
LOSS_LIMIT_ENABLED=true
LOSS_LIMIT_DOLLARS=-300
LOSS_LIMIT_POLL_SECS=15

# IB client ID for automation process (must not conflict with signal_smt.py's 15)
AUTOMATION_IB_CLIENT_ID=20

# IB client ID for the realtime-data verification script used by the run-orchestrator
# maintenance-break cycle (.claude/skills/run-orchestrator/scripts/verify_ib_realtime.py).
# Must not conflict with other IB clients (gap-fill 17, automation 20/21, signal_smt 15).
IB_VERIFY_CLIENT_ID=19

# IB contract IDs for the active quarterly MNQ / MES futures.
# Look up via TWS (right-click contract → Financial Instrument Info → Details)
# or run: uv run python -c "from ib_insync import IB,ContFuture; ib=IB(); ib.connect('127.0.0.1',4002,clientId=99); [print(s,ib.qualifyContracts(ContFuture(s,'CME','USD'))) for s in ['MNQ','MES']]; ib.disconnect()"
# Update after each quarterly rollover (Mar/Jun/Sep/Dec expiry).
MNQ_CONID=<mnq-front-month-conid>
MES_CONID=<mes-front-month-conid>

# Next quarterly rollover-prep date (Saturday before the next contract's expiry, YYYY-MM-DD).
# parquet-check runs the rollover-prep once current date >= this, then advances it a quarter.
ROLLOVER_PREP_DATE=<yyyy-mm-dd-saturday-before-next-expiry>

# Sessions directory for fills.jsonl output (default: sessions)
SESSIONS_DIR=sessions
